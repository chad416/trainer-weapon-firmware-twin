// Trainer weapon platform for Renode.
//
// Board section: copied from Zephyr
// boards/antmicro/stm32h7_renode_reference_board/support/stm32h7_renode_reference_board.repl
// (Copyright (c) 2026 Antmicro <www.antmicro.com>, SPDX-License-Identifier: Apache-2.0),
// with one fix and the trainer-specific additions marked below.

using "platforms/cpus/stm32h753.repl"

// FIX: the board has a 25 MHz HSE (board devicetree: clk_hse clock-frequency
// = 25 MHz). Renode's STM32H7_RCC defaults to 8 MHz, so with the firmware's
// PLL settings it set SysTick to 153.6 MHz instead of 480 MHz and firmware
// time ran at 0.32x Renode virtual time.
rcc:
    hseFrequency: 25000000

redRgbLed: Miscellaneous.LED @ gpioPortD 13

greenRgbLed: Miscellaneous.LED @ gpioPortD 14

blueRgbLed: Miscellaneous.LED @ gpioPortD 15

gpioPortD:
    13 -> redRgbLed@0
    14 -> greenRgbLed@0
    15 -> blueRgbLed@0

sw1: Miscellaneous.Button @ gpioPortG 7
    invert: true
    -> gpioPortG@7

sw2: Miscellaneous.Button @ gpioPortG 8
    invert: true
    -> gpioPortG@8

sw3: Miscellaneous.Button @ gpioPortG 9
    invert: true
    -> gpioPortG@9

sw4: Miscellaneous.Button @ gpioPortG 10
    invert: true
    -> gpioPortG@10

veml7700: Sensors.VEML7700 @ i2c1 0x10

iis2mdc: Sensors.IIS2MDC @ i2c1 0x1E

tmp108: Sensors.TMP108 @ i2c1 0x48

lps25hb: Sensors.LPS25HB @ i2c1 0x5D

lsm6dso: Sensors.LSM6DSO_IMU @ i2c1 0x6A

usart2:
    frequency: 200000000

timer3:
    frequency: 10000000

watchdog:
    frequency: 32000

qspiFlash: SPI.ISSI_IS25WP @ qspi
    underlyingMemory: flashMem

flashMem: Memory.MappedMemory @ sysbus 0x90000000
    size: 0x8000000

phy: Network.EthernetPhysicalLayer @ ethernet 0
    BasicControl: 0x3100
    BasicStatus: 0x782D
    Id1: 0x0007
    Id2: 0xC130
    AutoNegotiationAdvertisement: 0x01E1
    AutoNegotiationLinkPartnerBasePageAbility: 0x0001
    AutoNegotiationExpansion: 0x0064
    AutoNegotiationNextPageTransmit: 0x2001

potentiometer: Analog.Potentiometer @ adcM1S2 2
    minVolt: 0
    maxVolt: 3.3

sysbus:
    init:
        Tag <0x58024800 4> "PWR_CR1_DBP_SET" 0x100
        Tag <0x58024808 4> "PWR_CR2_BREN_SET" 0x1
        Tag <0x58024818 4> "D3CR.VOSRDY" 0x2000
        Tag <0x58026410 4> "HSEM_UNLOCK" 0x80000000 overridePeripheralAccesses=True

// TRAINER: emitter and recoil-valve gates on PE2/PE3 (see app overlay).
emitterGate: Miscellaneous.LED @ gpioPortE 2

valveGate: Miscellaneous.LED @ gpioPortE 3

gpioPortE:
    2 -> emitterGate@0
    3 -> valveGate@0
